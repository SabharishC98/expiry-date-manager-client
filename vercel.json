{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://expiry-date-manager-server.onrender.com/auth/:path*"
    },
    {
      "source": "/products/:path*",
      "destination": "https://expiry-date-manager-server.onrender.com/products/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
